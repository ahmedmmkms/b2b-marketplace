# Shell script to run Maven without requiring it to be installed
# Run ./mvnw instead of mvn to use this script

# The script uses the Maven Wrapper JAR file to download and run Maven.
# To upgrade the version of Maven being used, update the maven-wrapper.properties file.

# Check if the wrapper jar file is present, if not, download it
if [ ! -f .mvn/wrapper/maven-wrapper.jar ]; then
  echo "Downloading Maven Wrapper"
  # Create the directory if it doesn't exist
  mkdir -p .mvn/wrapper
  # Download the wrapper jar
  if command -v curl >/dev/null 2>&1; then
    curl -sSLo .mvn/wrapper/maven-wrapper.jar https://repo.maven.apache.org/maven2/org/apache/maven/wrapper/maven-wrapper/3.2.0/maven-wrapper-3.2.0.jar
  elif command -v wget >/dev/null 2>&1; then
    wget -O .mvn/wrapper/maven-wrapper.jar https://repo.maven.apache.org/maven2/org/apache/maven/wrapper/maven-wrapper/3.2.0/maven-wrapper-3.2.0.jar
  else
    echo "Either curl or wget is required to download the Maven Wrapper"
    exit 1
  fi
fi

# Check if JAVA_HOME is set
if [ -z "$JAVA_HOME" ]; then
    echo "JAVA_HOME is not set. Please set JAVA_HOME to point to your Java installation."
    exit 1
fi

# Set up the classpath to include the wrapper jar
MAVEN_WRAPPER_JAR=".mvn/wrapper/maven-wrapper.jar"
MAVEN_WRAPPER_MAIN="org.apache.maven.wrapper.MavenWrapperMain"

# Set up the command to run Maven
MVN_CMD="$JAVA_HOME/bin/java"
MVN_OPTS="$MAVEN_OPTS"
MVN_DEBUG_OPTS=""

# Check if debug flag is set
if [ "$MVN_DEBUG" = "true" ]; then
    MVN_DEBUG_OPTS="-Xdebug -Xnoagent -Djava.compiler=NONE -Xrunjdwp:transport=dt_socket,server=y,suspend=y,address=8000"
fi

# Run Maven
exec $MVN_CMD $MVN_OPTS $MVN_DEBUG_OPTS -classpath "$MAVEN_WRAPPER_JAR" "$MAVEN_WRAPPER_MAIN" "$@"