# Cloudflare Pages Configuration

# The following environment variables need to be set in the Cloudflare Pages dashboard:
# - NEXT_PUBLIC_BACKEND_URL: The URL of your backend API
# - NEXT_PUBLIC_ENVIRONMENT: The current environment (e.g., development, staging, production)
# - NEXT_PUBLIC_SENTRY_DSN (optional): If you're using Sentry for error tracking

# Build configuration
[build]
  command = "cd frontend && pnpm build"
  output = "frontend/out"

[env]
  NEXT_PUBLIC_BACKEND_URL = "https://your-backend-url.com"
  NEXT_PUBLIC_ENVIRONMENT = "production"

# Routes that should bypass the CDN and go straight to the function
[[routes]]
  pattern = "/api/*"
  upstream = "backend-api"

# Additional configuration for internationalized content
[[headers]]
  for = "/*"
  [headers.values]
    Link = "</_next/static/locales/ar.json>; rel=preload; as=fetch; crossorigin, </_next/static/locales/en.json>; rel=preload; as=fetch; crossorigin"