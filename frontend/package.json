{
  "name": "b2b-marketplace-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "gen:api": "pnpm gen:types && pnpm gen:hooks",
    "gen:types": "openapi-typescript ../docs/openapi.yaml -o libs/api/types.ts",
    "gen:hooks": "orval --config libs/api/orval.config.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.6.1",
    "@radix-ui/react-alert-dialog": "^1.0.6",
    "@radix-ui/react-dialog": "^1.0.6",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-icons": "^1.3.0",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-scroll-area": "^1.1.0",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-slot": "^1.0.2",
    "@tanstack/react-query": "^5.44.0",
    "@tanstack/react-query-devtools": "^5.44.0",
    "@tanstack/react-table": "^8.13.4",
    "autoprefixer": "^10.4.19",
    "axios": "^1.6.8",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "lucide-react": "^0.365.0",
    "next": "14.2.5",
    "next-intl": "^4.4.0",
    "next-themes": "^0.3.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "^7.50.0",
    "postcss": "^8.4.38",
    "sonner": "^1.4.0",
    "tailwind-merge": "^2.2.1",
    "tailwindcss": "^3.4.3",
    "tailwindcss-animate": "^1.0.7",
    "zustand": "^4.5.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.44.0",
    "@testing-library/jest-dom": "^6.4.3",
    "@testing-library/react": "^14.2.2",
    "@testing-library/user-event": "^14.5.1",
    "@vitejs/plugin-react": "^4.3.1",
    "@types/node": "20.12.12",
    "@types/react": "18.3.2",
    "@types/react-dom": "18.3.0",
    "@types/node-fetch": "^2.6.11",
    "@typescript-eslint/eslint-plugin": "^7.12.0",
    "@typescript-eslint/parser": "^7.12.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.5",
    "eslint-config-prettier": "^9.1.0",
    "jsdom": "^24.0.0",
    "openapi-typescript": "^6.7.2",
    "orval": "^6.20.0",
    "prettier": "^3.2.5",
    "prettier-plugin-tailwindcss": "^0.5.13",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5",
    "vite": "5.4.12",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=18.17"
  },
  "packageManager": "pnpm@8.15.7"
}
